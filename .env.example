# Required. There is no offline mode: the workflow reads evidence with a model
# or it does not run.
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional overrides.
# DATA_DIR=data
# QUARTER=2026-Q3
# MODEL=claude-opus-4-6
# READER_MODEL=claude-sonnet-4-6

# Two steering controls, and the model decides which one is sent. Setting the
# wrong one is harmless — it is simply not sent — but there is no way to use
# both, because a model that takes one rejects the other with a 400.
#
# TEMPERATURE — models up to and including Claude 4.6. 0 narrows sampling as
# far as the API allows. It does not make runs reproducible and never did.
# TEMPERATURE=0
#
# EFFORT — Claude Opus 4.7 and later, and the 5 line, where temperature was
# removed: low | medium | high | xhigh | max. Lower values scope the work more
# tightly and make runs more alike, at the risk of returning a structured
# object with fields missing — which is what medium did to the compose pass.
# EFFORT=high

# Output budget. Unset, each request carries the model's full output ceiling so
# a structured object is never cut off mid-field — thinking counts against this
# budget, and a truncated response surfaces as a parse failure, not a short
# answer. Set an integer only to bound spend.
# MAX_TOKENS=
